          "raw": "{\n  \"id_pengajuan\": 1,\n  \"id_kategori\": 1,\n  \"tanggal_pengeluaran\": \"2026-09-08\",\n  \"deskripsi\": \"Biaya taksi bandara menuju hotel\",\n  \"jumlah\": 175000,\n  \"metode_pembayaran\": \"Cash Reimburse\",\n  \"sudah_diganti\": false\n}"
        },
        "url": {
          "raw": "{{base_url}}/pengeluaran-perjalanan",
          "host": ["{{base_url}}"],
          "path": ["pengeluaran-perjalanan"]
        }
      }
    },
    {
      "name": "8. Get All Departemen",
      "request": {
